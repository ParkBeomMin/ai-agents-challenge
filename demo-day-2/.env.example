# Weather branch (OpenWeather Current = "now" at request time; not tied to --date/--time)
OPENWEATHER_API_KEY=

# Optional: AstronomyAPI (https://astronomyapi.com) — solar system positions over REST.
# If unset, moon/planets use Skyfield+DE421 locally.
ASTRONOMY_API_APPLICATION_ID=
ASTRONOMY_API_APPLICATION_SECRET=
# Optional: observer elevation in meters (passed to AstronomyAPI; default 0)
OBSERVER_ELEVATION_M=0

# Required: OpenAI for learning content and quizzes
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
